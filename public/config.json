{
  "config": {
    "fontsUrls": ["/public/santegraphie.css"],
    "logoUrl": "/public/logo_santegraphie.svg",
    "hideLogin": false,
    "lang": "fr",
    "displayFullnameInAccountBtn": true,
    "accountMenu": [
      {
        "label": "Mes cartes",
        "url": "/mapstore/#/home"
      },
      {
        "label": "Services",
        "url": "/geoserver/web",
        "hasRole": "ROLE_ADMINISTRATOR"
      },
      {
        "label": "Métadonnées",
        "url": "/geonetwork/srv/fre/admin.console#/home",
        "hasRole": "ROLE_GN_ADMIN"
      },
      {
        "label": "MviewerStudio",
        "url": "/mviewerstudio/",
        "hasRole": "ROLE_USER"
      },
      {
        "label": "Gaïa",
        "url": "/gaia/",
        "hasRole": "ROLE_SUPERUSER"
      },
      {
        "label": "Superset",
        "url": "/superset/",
        "hasRole": "ROLE_SUPERSET_ADMIN"
      },
      {
        "label": "Cartes admin",
        "url": "/mapstore/#/admin",
        "hasRole": "ROLE_MAPSTORE_ADMIN"
      },
      {
        "label": "Utilisateurs",
        "url": "/console/manager/home",
        "hasRole": "ROLE_SUPERUSER"
      }
    ],
    "login": {
      "url": ":currentUrl",
      "params": [
        {
          "login": ""
        }
      ],
      "showAccountBtnText": true,
      "customClass": "santegraphie-account"
    },
    "logoutUrl": "/logout",
    "stylesheet": "/public/santegraphie.css"
  },
  "navigation": {
    "class": "justify-between",
    "menus": [
      [
        {
          "label": "Catalogue",
          "url": "/datahub/",
          "activeAppUrl": "/datahub",
          "iconUrl": "data:image/svg+xml;base64,"
        },
        {
          "label": "Carte simple",
          "url": "/analyse/",
          "activeAppUrl": "/analyse",
          "target": "_blank",
          "iconUrl": "data:image/svg+xml;base64,"
        },
        {
          "label": "Carte évoluée",
          "url": "/mapstore/",
          "activeAppUrl": "/mapstore/",
          "iconUrl": "data:image/svg+xml;base64,"
        }
      ],
      [
        {
          "label": "Tutoriels",
          "url": "/accueil/tutoriels",
          "activeAppUrl": "/accueil/tutoriels",
          "hideMobile": true,
          "iconUrl": "data:image/svg+xml;base64,",
          "customClass": "santegraphie-tutorials"
        }
      ]
    ]
  },
  "i18n": {
    "fr": {
      "account_details": "Mon compte",
      "login": "connexion",
      "logout": "déconnexion"
    }
  }
}
